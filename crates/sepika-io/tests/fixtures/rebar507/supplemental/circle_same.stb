<ST_BRIDGE xmlns="https://www.building-smart.or.jp/dl" version="2.0.2">
  <StbCommon project_name="independent" app_name="research_fixture" app_version="1"><StbApplyConditionsList><StbColumn_RC_RebarPositionApply set_default="true" center="51"/><StbBeam_RC_RebarPositionApply set_default="true" center_top_bottom="51" center_side="51"/></StbApplyConditionsList></StbCommon>
  <StbModel>
